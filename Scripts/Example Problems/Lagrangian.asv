% mass spring
syms x(t) k

L = 1/2*diff(x,t)^2 - 1/2*k*x^2 %[output:8431d651]

q = {x};

eom = createEOM(L, q) %[output:598e140e]
%%
% pendulum
syms theta(t) m l g y

L = 1/2*m*diff(theta)^2*l^2 + m*g*l*cos(theta) %[output:82c3cbe8]

q = {theta};

eom = createEOM(L,q) %[output:90525b09]
%%
% inverted pendulum
syms M m x(t) I theta(t) l g

L = 1/2*((M+m)*diff(x)^2+I*diff(theta)^2) + m*l*cos(theta)*diff(theta)*diff(x) - m*g*l*cos(theta) %[output:1b351546]

q = {x, theta} %[output:1755af5a]

eom = createEOM(L,q) %[output:3335c7e8]
%%
syms r(t) theta(t) phi(t) mu J2 R0 t

assume(mu > 0);
assume(J2 > 0);
assume(R0 > 0);

q = {r,theta,phi} %[output:07413f7d]

L = 1/2*(diff(r,t)^2 + r^2*diff(theta,t)^2 + r^2*sin(theta)^2*diff(phi,t)^2) + mu/r - mu*J2*R0^2 / (2*r^3) * (3*cos(theta)^2 - 1) %[output:6f0b53f0]

eom = createEOM(L,q) %[output:70f2d44c]

syms r_ddot phi_ddot theta_ddot phi_dot r_dot theta_dot%phi theta

equations = subs(eom, [diff(r(t),t,2), diff(theta(t),t,2), diff(phi(t),t,2), ... %[output:group:3071b2cd] %[output:31c7a191]
    diff(r(t),t,1), diff(theta(t), t, 1), diff(phi(t), t, 1)],[r_ddot theta_ddot phi_ddot r_dot theta_dot phi_dot]) %[output:group:3071b2cd] %[output:31c7a191]





%%
% double pendulum
syms m l theta(t) phi(t) g omega alpha

assume(l > 0);
assume(m > 0);

L = 1/2*m*l^2*(2*diff(theta)^2+diff(phi)^2+2*diff(theta)*diff(phi)*cos(theta-phi))+m*g*l*(2*cos(theta)+cos(phi)) %[output:7508a9dd]

q = {theta, phi} %[output:93e02308]

eom = createEOM(L,q) %[output:6ccdc387]
% Compute simplified symbolic expression %[task:01ce]
simplifiedExpr = simplify(eom,"Steps",6400) %[task:01ce] %[output:5c6a0567]

syms theta_ddot phi_ddot theta_dot phi_dot %phi theta

equations = subs(simplifiedExpr, [diff(theta(t),t,2), diff(phi(t),t,2), ... %[output:group:1da9c037] %[output:778178af]
    diff(theta(t), t, 1), diff(phi(t), t, 1)],[theta_ddot phi_ddot theta_dot phi_dot]) %[output:group:1da9c037] %[output:778178af]

syms theta phi

equations = [2*g*sin(theta) + 2*l*theta_ddot == l*phi_dot^2*sin(phi - theta) - l*phi_ddot*cos(phi - theta); l*sin(phi - theta)*theta_dot^2 + g*sin(phi) + l*phi_ddot == l*theta_ddot*(2*sin(phi/2 - theta/2)^2 - 1)] %[output:522f918a]

sol = solve(equations == [0; 0], [theta_ddot, phi_ddot]) %[output:950d57fa]

theta = simplify(sol.theta_ddot, "Steps", 6400) %[output:71f4e006]
phi = simplify(sol.phi_ddot, "Steps", 6400) %[output:79a3f516]

%%
function eom = createEOM(L, q)
% createEOM  Generate Euler–Lagrange equations
%
% L: symbolic Lagrangian
% q: vector of generalized coordinates (symbolic functions of t)


% create a time variable
syms t

% for each generalized coordinate, create an EOM

for idx = 1:length(q)

    % Generalized velocity
    qd = diff(q{idx}, t);

    % Euler–Lagrange equations
    eom(idx) = diff(diff(L, qd), t) - diff(L, q{idx}) == 0;

end

eom = eom.';
end


